# Copy to /workspace/orion.env on the pod and fill in. Lines are sourced by bash,
# so keep the quotes exactly as shown.

# ---- model ----
MODEL_PROFILE=awq48              # awq48 = 4-bit community build, one 48 GB GPU | bf16 = official weights, 80 GB+ (2x80 realistic)
# HF_TOKEN=                      # only needed if Hugging Face asks for a login

# ---- Google Drive via rclone (no interactive login on the pod) ----
# Your three Drive folders, by ID (the long text at the end of the folder's link):
ORION_DRIVE_INPUT_ID=1uI2d6Q3kUP2kSj0RmM38x0mbMYOEa5dK    # "Input videos": a subfolder per video, or loose video files
ORION_DRIVE_STAGES_ID=14hujY-mM-qwx1rKd-x2Y3lJZGeuT_h_W   # "Each stage": every video's stage outputs (resume data)
ORION_DRIVE_SFT_ID=16p6siz_XC2VrNojWrhRc5ENwElit14Nu       # "Output SFT": the 4 final *_sft.jsonl files, ready for LoRA
# (Alternative single-root layout, instead of the three IDs above:  ORION_DRIVE_REMOTE=gdrive:Orion  -> Orion/INPUT + Orion/OUTPUT)
ORION_DRIVE_REMOTE_NAME=gdrive
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive
# Paste the token JSON that `rclone authorize "drive"` prints on YOUR PC (single quotes!).
# It must be from the Google account that OWNS (or can EDIT) those folders. "Anyone with the link"
# does not replace this token: writing results back needs a signed-in account.
RCLONE_CONFIG_GDRIVE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'

# ---- behaviour ----
ORION_USE_AGENTS=0               # 0 = ignore every P1_A*.jsonl, read everything from the video itself (default)
# ORION_WHISPER_MODEL=large-v3-turbo   # speech-to-text model; "large-v3" is slower but a bit more accurate
ORION_CLEAN_INPUT=0              # 0 = never delete anything (default). 1 = delete a finished video from POD disk only (Drive always keeps it)
# ORION_CLIP_HEIGHT=360          # lower (e.g. 288) / ORION_CLIP_FPS=1 if the model runs out of memory
